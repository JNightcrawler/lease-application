# Copy this file's values into your shell, a .env loader, or your hosting
# platform's environment variable settings.

# For local Docker Postgres (docker-compose up -d), these defaults work as-is.
DB_URL=jdbc:postgresql://localhost:5432/lease_application
DB_USERNAME=lease_user
DB_PASSWORD=lease_password

# For a free hosted Postgres instead, use the connection details it gives you, e.g.:
#   Neon:      jdbc:postgresql://<host>.neon.tech/<db>?sslmode=require
#   Supabase:  jdbc:postgresql://<host>.supabase.co:5432/postgres
#   Railway:   jdbc:postgresql://<host>.railway.app:<port>/railway
#   Render:    jdbc:postgresql://<host>.render.com:5432/<db>

PORT=8080
SHOW_SQL=false
APP_LOG_LEVEL=INFO
